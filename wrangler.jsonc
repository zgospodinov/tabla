{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tabla",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  // Достъп само от собствения адрес: без *.workers.dev и без preview адреси.
  "routes": [{ "pattern": "tabla.gospodinov.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/img/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // Ограничение на заявките по IP адрес (period е 10 или 60 секунди).
  "ratelimits": [
    { "name": "LIMIT_CREATE", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "LIMIT_ROOM", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  // Картинки на дъската за писмата с анализ (трият се автоматично след 90 дни — правило в R2).
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "tabla-analysis-img" }],
  // Шрифтът за номерата на точките в картинките се вгражда като двоични данни.
  "rules": [{ "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }],
  "vars": { "PUBLIC_URL": "https://tabla.gospodinov.dev", "BREVO_TEMPLATE_ID": "1" },
  "observability": { "enabled": true }
}
